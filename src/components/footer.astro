---
import { site } from "../data/site";

interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer class:list={["site-footer", wide && "is-wide"]} data-pagefind-ignore>
  <span>
    {site.title} · v{site.version}
  </span>
  <span class="footer-links">
    <a href={site.github}>GitHub</a>
    <a href={site.x}>X</a>
    <a href={site.bun}>Built for Bun</a>
  </span>
</footer>
