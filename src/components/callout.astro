---
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import Icon from "./icon.astro";

interface Props {
  title?: string;
  type?: "note" | "tip" | "warning";
}

const { title, type = "note" } = Astro.props;
const icon = { note: "info", tip: "lightbulb", warning: "alert" }[type] as "info" | "lightbulb" | "alert";
---

<Alert className="callout" data-type={type}>
  <Icon name={icon} />
  {title && <AlertTitle className="text-sm font-semibold">{title}</AlertTitle>}
  <AlertDescription className="font-sans text-[0.9375rem]! leading-relaxed! text-foreground">
    <slot />
  </AlertDescription>
</Alert>
