---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<article class="principle">
  <h3 id={id}>
    {title}
    <a class="anchor" href={`#${id}`} aria-label={`Link to ${title}`} data-pagefind-ignore>
      #
    </a>
  </h3>
  <p>
    <slot />
  </p>
</article>
