---
const inward = [
  { name: "Request", note: "arrives", tag: "GET /users" },
  { name: "Logging", note: "starts a timer", tag: "+ timer" },
  { name: "Guard", note: "checks the caller", tag: "+ user" },
  { name: "Validation", note: "parses the body", tag: "+ body" },
  { name: "Handler", note: "does the work", tag: "working…" },
];
const outward = [
  { name: "Handler", note: "returns", tag: "200 · data" },
  { name: "Interceptor", note: "reshapes the result", tag: "reshaped" },
  { name: "Auth", note: "sets the headers", tag: "+ headers" },
  { name: "Error handler", note: "catches failures", tag: "no errors" },
  { name: "Response", note: "is sent", tag: "200 OK" },
];
const last = inward.length - 1;
---

<div class="pipeline" data-pipeline>
  <div class="envelope" aria-hidden="true">
    <span class="envelope-icon">✉</span>
    <span class="envelope-tag"></span>
  </div>
  <ol class="pipeline-row" aria-label="Going in">
    {inward.map(({ name, note, tag }, i) => (
      <li class={i === last ? "stage is-core" : i === 0 ? "stage is-end" : "stage"} data-tag={tag}>
        <span class="stage-name">{name}</span>
        <span class="stage-note">{note}</span>
      </li>
    ))}
  </ol>
  <ol class="pipeline-row is-out" aria-label="Coming back out">
    {outward.map(({ name, note, tag }, i) => (
      <li class={i === 0 ? "stage is-core" : i === last ? "stage is-end" : "stage"} data-tag={tag}>
        <span class="stage-name">{name}</span>
        <span class="stage-note">{note}</span>
      </li>
    ))}
  </ol>
</div>
<p class="pipeline-status" data-pipeline-status aria-hidden="true"></p>

<script>
  const pipeline = document.querySelector<HTMLElement>("[data-pipeline]");
  const track = document.querySelector<HTMLElement>("[data-pin]");
  const desktop = matchMedia("(min-width: 48rem)");
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  if (pipeline && track) {
    const stages = [...pipeline.querySelectorAll<HTMLElement>(".stage")];
    const envelope = pipeline.querySelector<HTMLElement>(".envelope")!;
    const tag = envelope.querySelector<HTMLElement>(".envelope-tag")!;
    const status = document.querySelector<HTMLElement>("[data-pipeline-status]")!;
    const half = stages.length / 2;
    let frame = 0;

    const center = (el: HTMLElement, box: DOMRect) => {
      const r = el.getBoundingClientRect();
      return { x: r.left - box.left + r.width / 2, y: r.top - box.top };
    };

    const update = () => {
      frame = 0;
      const rect = track.getBoundingClientRect();
      const range = rect.height - innerHeight;
      const p = Math.min(1, Math.max(0, range > 0 ? -rect.top / range : 0));
      const t = Math.min(1, Math.max(0, (p - 0.08) / 0.84)) * (stages.length - 1);
      const i = Math.min(stages.length - 2, Math.floor(t));
      const f = t - i;
      const box = pipeline.getBoundingClientRect();
      const a = center(stages[i], box);
      const b = center(stages[i + 1], box);
      envelope.style.transform = `translate(${a.x + (b.x - a.x) * f}px, ${a.y + (b.y - a.y) * f}px) translate(-50%, -50%)`;

      const active = Math.round(t);
      stages.forEach((s, n) => {
        s.classList.toggle("is-done", n < active);
        s.classList.toggle("is-active", n === active);
      });
      const current = stages[active];
      tag.textContent = current.dataset.tag ?? "";
      envelope.classList.toggle("is-response", active >= half);
      status.textContent = `${current.querySelector(".stage-name")!.textContent} ${current.querySelector(".stage-note")!.textContent}`;
    };

    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    let on = false;
    const sync = () => {
      const want = desktop.matches && !calm.matches;
      if (want === on) return;
      on = want;
      pipeline.classList.toggle("is-scrub", on);
      track.classList.toggle("is-pinned", on);
      status.hidden = !on;
      const method = on ? "addEventListener" : "removeEventListener";
      window[method]("scroll", queue, { passive: true });
      window[method]("resize", queue);
      if (on) update();
    };

    desktop.addEventListener("change", sync);
    calm.addEventListener("change", sync);
    sync();
  }
</script>
