---
import "../styles/global.css";
import { site } from "../data/site";
import { homeImage, iconUrl, serializeJsonLd, twitterHandle } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  jsonLd?: object;
}

const { title, description, noindex = false, image = homeImage, imageAlt = site.title, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href={iconUrl(192)} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={iconUrl(180)} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141a1a" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var media = matchMedia("(prefers-color-scheme: dark)");
        var stored = null;
        try {
          stored = localStorage.getItem("rhythm-theme");
        } catch (error) {}
        root.classList.toggle("dark", stored === "dark" || (stored !== "light" && media.matches));
        media.addEventListener("change", function (event) {
          var chosen = null;
          try {
            chosen = localStorage.getItem("rhythm-theme");
          } catch (error) {}
          if (chosen !== "light" && chosen !== "dark") root.classList.toggle("dark", event.matches);
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <script>
      document.addEventListener("click", async (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>("button.copy");
        if (!button) return;
        const text = button.dataset.copy ?? button.closest(".code")?.querySelector("pre")?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text.replace(/\n$/, ""));
          button.setAttribute("data-copied", "");
          setTimeout(() => button.removeAttribute("data-copied"), 1800);
        } catch {}
      });

      const current = document.querySelector<HTMLElement>(".sidebar [aria-current='page']");
      const sidebar = current?.closest<HTMLElement>(".sidebar");
      if (current && sidebar) {
        const offset = current.offsetTop - sidebar.clientHeight / 2 + current.clientHeight / 2;
        sidebar.scrollTop = Math.max(0, offset);
      }
    </script>
  </body>
</html>
