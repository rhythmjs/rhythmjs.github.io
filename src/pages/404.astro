---
import BaseLayout from "../layouts/base-layout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const large = (variant: "default" | "secondary") => cn(buttonVariants({ variant, size: "lg" }), "h-10 px-4 text-sm");
---

<BaseLayout title="Page not found · RhythmJS" description="This page does not exist." noindex>
  <Header />
  <main id="main" class="landing" tabindex="-1">
    <section class="landing-section">
      <div class="landing-inner not-found">
        <span class="code-404">404</span>
        <h1>This page is off the beat.</h1>
        <p class="lead">The page you are looking for moved or never existed. Try the search, or start from the top.</p>
        <div class="flex flex-wrap gap-2">
          <a class={large("default")} href="/">
            Back to the landing page
          </a>
          <a class={large("secondary")} href="/tutorial/">
            Tutorial
          </a>
          <a class={large("secondary")} href="/rhythm/">
            Packages
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer wide />
</BaseLayout>
