{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "scripts", "astro.config.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
